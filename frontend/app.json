{
  "expo": {
    "name": "The Legacy Lab",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Registra il tuo mini video di candidatura",
        "NSMicrophoneUsageDescription": "Registra l'audio del tuo video",
        "NSPhotoLibraryUsageDescription": "Scegli un video dalla tua galleria"
      },
      "bundleIdentifier": "com.emergent.videocasting.oecakc"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F1A2A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_IMAGES"
      ],
      "package": "com.emergent.videocasting.oecakc"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1A2A"
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Scegli un video dalla tua galleria",
          "cameraPermission": "Registra il tuo mini video di candidatura",
          "microphonePermission": "Registra l'audio del tuo video"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
