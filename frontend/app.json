{
  "expo": {
    "name": "The Legacy Lab",
    "slug": "the-legacy-lab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "legacylab",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Registra il tuo mini video di candidatura",
        "NSMicrophoneUsageDescription": "Registra l'audio del tuo video",
        "NSPhotoLibraryUsageDescription": "Scegli un video dalla tua galleria"
      },
      "bundleIdentifier": "com.thelegacylab.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F1A2A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "package": "com.thelegacylab.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1A2A"
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F57C00",
          "androidMode": "default",
          "androidCollapsedTitle": "The Legacy Lab"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Scegli un video dalla tua galleria",
          "cameraPermission": "Registra il tuo mini video di candidatura",
          "microphonePermission": "Registra l'audio del tuo video"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f8b38ac-3e48-4999-b39a-4317316e8a8c"
      }
    },
    "owner": "vivisvivis"
  }
}
